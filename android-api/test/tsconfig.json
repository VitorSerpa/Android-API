{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "../src/*"
      ],
      "@/assets/*": [
        "../assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../.expo/types/**/*.ts",
    "../expo-env.d.ts"
  ],
  "exclude": []
}
