# Firebase — copie para `.env.local` (não versionado) e preencha com os dados do
# seu app web em Console do Firebase → Configurações do projeto → Seus apps.
# Ative o provedor "E-mail/senha" em Authentication → Método de login.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional, só em desenvolvimento: usa o Auth Emulator local em vez do Firebase
# real (`npx firebase-tools emulators:start --only auth --project demo-mente`).
# No emulador Android, rode também `adb reverse tcp:9099 tcp:9099`.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
