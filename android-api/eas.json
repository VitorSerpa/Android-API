{
  "cli": {
    "version": ">= 22.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "ios-sideload": {
      "environment": "preview",
      "env": {
        "IOS_CONFIGURATION": "Release"
      },
      "ios": {
        "withoutCredentials": true,
        "config": "ios-sideload.yml"
      }
    },
    "ios-sideload-dev": {
      "environment": "development",
      "developmentClient": true,
      "env": {
        "IOS_CONFIGURATION": "Debug",
        "IOS_ALLOW_HTTP": "1"
      },
      "ios": {
        "withoutCredentials": true,
        "config": "ios-sideload.yml"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
